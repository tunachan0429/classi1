# ============================================================
#  設定ファイル
#  このファイルを ".env" という名前でコピーして、値を書き換えてください。
#  (ファイル名の先頭のドットを消さないこと)
# ============================================================

# 【必須】Google AI Studio で取得した Gemini の API キー
#  取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=ここにAPIキーを貼り付け

# 【必須】問題ページのURL
QUIZ_URL=https://example.com/your-quiz-page

# ============================================================
#  ログイン設定 (自分のサイトにログインが必要な場合だけ)
#  ※ 下の3つ(URL/ユーザー/パスワード)をすべて設定するとログインします。
#     1つでも空ならログインはスキップされます。
# ============================================================

# ログインページのURL
LOGIN_URL=

# ログインのユーザー名 / ID
LOGIN_USER=

# ログインのパスワード
LOGIN_PASS=

# --- 入力欄・ボタンのセレクタ (通常は既定のままでOK。合わなければ変更) ---
# ユーザー名の入力欄
LOGIN_USER_SELECTOR=input[name=username]
# パスワードの入力欄
LOGIN_PASS_SELECTOR=input[type=password]
# ログインボタン
LOGIN_BUTTON_SELECTOR=button[type=submit]
# 【2段階ログイン用】ユーザー名を入れた後に押す「次へ」ボタンのセレクタ(任意)
#  ユーザー名→次へ→パスワード…と進むサイトの場合に設定します。
#  空でも、ログインボタン兼用として自動で「次へ」を押そうとします。
LOGIN_NEXT_SELECTOR=
# ログイン成功の目印(ログイン後だけ現れる要素のセレクタ。任意。空なら確認しない)
LOGIN_SUCCESS_SELECTOR=

# 使用するGeminiモデル (無料枠で使えるもの)
GEMINI_MODEL=gemini-2.5-flash

# ブラウザを画面に表示するか (true=表示して動きが見える / false=裏で実行)
HEADLESS=false

# 動作をゆっくりにする(ミリ秒)。動きを見たいなら 300〜800 くらいがおすすめ
SLOW_MO_MS=400

# 問題全体を囲んでいる要素のCSSセレクタ (表・図もこの範囲をスクショします)
QUESTION_SELECTOR=tui-section-question

# 解答欄(ラジオボタン群)のセレクタ
FORM_SELECTOR=tui-single-select-form

# ラジオボタンのname属性
RADIO_NAME=answer-option

# ============================================================
#  1問ずつ「選択 → 回答ボタン → 次の問題」で進むサイト向け
# ============================================================

# 1問ごとに押す「回答」ボタンのセレクタ
#  空欄なら「回答」「解答」「次へ」などの文言から自動で探します。
#  自動で見つからない/違うボタンを押す場合はここに実際のセレクタを設定してください。
ANSWER_BUTTON_SELECTOR=

# 回答後に「正解/不正解」などのフィードバック画面が出て、
# さらに「次へ」ボタンを押す必要があるサイト向け(任意)。ここにセレクタを設定するとそのボタンを押します。
NEXT_SELECTOR=

# 「次へ」ボタンを文言(次へ/次の問題 等)から自動で探して押すか。
#  誤クリック防止のため既定は false。回答ボタンだけで次に進めるなら false のままでOK。
AUTO_NEXT=false

# 「中断しますか?」などブラウザの確認ダイアログが出たときの対応
#  accept  = OK を押す(次の問題へ進む。基本はこちら)
#  dismiss = キャンセルを押す(そのページに留まる)
#  ※ ページ離脱の確認(beforeunload)は設定に関わらず常に承諾して次へ進みます
DIALOG_ACTION=accept

# 解く問題数の上限(暴走防止。多めでOK)
MAX_QUESTIONS=200

# 次の問題/解答欄を待つときのタイムアウト(ミリ秒)。
# これを過ぎても次の問題が出なければ「全問終了」とみなして終了します。
QUESTION_TIMEOUT_MS=20000

# 全問終わった後に一度だけ押す「採点/送信」ボタンのセレクタ (使わないなら空のまま)
SUBMIT_SELECTOR=

# ============================================================
#  課題を自動で巡回するモード
#  (ホーム→学習トレーニング→課題→課題を上から選択→開始する→解答→
#   答え合わせへ→課題詳細画面へ→次の課題… を全自動で繰り返す)
# ============================================================

# true にすると自動巡回モードになります。
#  ※ このモードを使うときは必ず true にしてください(false のままだと1ページだけ解いて止まります)
AUTO_ASSIGNMENTS=false

# 自動巡回モードで「最初に開くホーム画面」のURL。
#  ここを設定しておくと分かりやすいです(空なら上の QUIZ_URL を使います)。
HOME_URL=

# 各画面で押すボタンの文言(あなたのサイトの表示に合わせて変更可)
TRAINING_TEXT=学習トレーニング
ASSIGNMENT_MENU_TEXT=課題
START_TEXT=開始する
GRADING_TEXT=答え合わせ
BACK_TO_LIST_TEXT=課題詳細画面へ

# 課題一覧の各項目(カード)のCSSセレクタ。
#  空欄なら「未完了」バッジを含むカードを自動で推定します。
#  うまく課題を選べない場合はここに実際のカードのセレクタを設定してください。
ASSIGNMENT_SELECTOR=

# 「まだ解いていない課題」を表す文言(この文言を含む課題を上から順に解きます)
INCOMPLETE_TEXT=未完了

# 巡回する課題数の上限(暴走防止)
MAX_ASSIGNMENTS=50

# 1つの課題あたりのステップ数の上限(暴走防止)。
#  課題は「テストを解く」「おすすめ演習」など複数ステップがあり、
#  詳細画面に「開始する」が無くなるまで(全ステップ完了まで)自動で解きます。
MAX_STEPS=20
