# ============================================================
#  設定ファイル
#  このファイルを ".env" という名前でコピーして、値を書き換えてください。
#  (ファイル名の先頭のドットを消さないこと)
# ============================================================

# 【必須】Google AI Studio で取得した Gemini の API キー
#  取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=ここにAPIキーを貼り付け

# 【必須】問題ページのURL
QUIZ_URL=https://example.com/your-quiz-page

# ============================================================
#  ログイン設定 (自分のサイトにログインが必要な場合だけ)
#  ※ 下の3つ(URL/ユーザー/パスワード)をすべて設定するとログインします。
#     1つでも空ならログインはスキップされます。
# ============================================================

# ログインページのURL
LOGIN_URL=

# ログインのユーザー名 / ID
LOGIN_USER=

# ログインのパスワード
LOGIN_PASS=

# --- 入力欄・ボタンのセレクタ (通常は既定のままでOK。合わなければ変更) ---
# ユーザー名の入力欄
LOGIN_USER_SELECTOR=input[name=username]
# パスワードの入力欄
LOGIN_PASS_SELECTOR=input[type=password]
# ログインボタン
LOGIN_BUTTON_SELECTOR=button[type=submit]
# 【2段階ログイン用】ユーザー名を入れた後に押す「次へ」ボタンのセレクタ(任意)
#  ユーザー名→次へ→パスワード…と進むサイトの場合に設定します。
#  空でも、ログインボタン兼用として自動で「次へ」を押そうとします。
LOGIN_NEXT_SELECTOR=
# ログイン成功の目印(ログイン後だけ現れる要素のセレクタ。任意。空なら確認しない)
LOGIN_SUCCESS_SELECTOR=

# 使用するGeminiモデル (無料枠で使えるもの)
GEMINI_MODEL=gemini-2.5-flash

# ブラウザを画面に表示するか (true=表示して動きが見える / false=裏で実行)
HEADLESS=false

# 動作をゆっくりにする(ミリ秒)。動きを見たいなら 300〜800 くらいがおすすめ
SLOW_MO_MS=400

# 問題全体を囲んでいる要素のCSSセレクタ (表・図もこの範囲をスクショします)
QUESTION_SELECTOR=tui-section-question

# 解答欄(ラジオボタン群)のセレクタ
FORM_SELECTOR=tui-single-select-form

# ラジオボタンのname属性
RADIO_NAME=answer-option

# 選択後に自動で押す「採点/送信」ボタンのセレクタ (使わないなら空のまま)
SUBMIT_SELECTOR=
